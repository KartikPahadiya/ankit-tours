APP_NAME=Ankit Travels API

# Development (SQLite)
DATABASE_URL=sqlite:///travelnest.db

# Production (PostgreSQL from Render/Neon/Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

JWT_SECRET_KEY=change-this-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed frontend origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173"]

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
BOOKING_HOLD_MINUTES=10

# Email (optional)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Admin inbox — payment alerts (₹ received) are emailed here
ADMIN_EMAIL=

# WhatsApp Cloud API (optional)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# Cloudinary (optional, for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
